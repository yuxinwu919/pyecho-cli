function [] = last_Astra_solution(last_Astra_log)
% get name of last Astra solution from log file

f_in = fopen(last_Astra_log);
nend=0; nnend=0;
while 1
      card=fgetl(f_in);
      if ~ischar(card), break, end
      if length(strfind(card,'End of Input deck'))>0, nnend=1; end
      nend=nend+nnend;
      if nend==2, card, end
      if nend==3
          name=card(1:);
      end
end
fclose(f_in);
