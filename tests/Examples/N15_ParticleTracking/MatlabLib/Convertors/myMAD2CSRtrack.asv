clear all
zstart=137; zstop=147;
% read longlist from WD
%[name path] = uigetfile('*.*',  'All Files (*.*)')

%proj_name = 'XFEL';path = 'D:\mad8\_XFEL\';
proj_name = 'FLASH';path = 'D:\mad8\_FLASH\';
name = 'longlist.dat';
fid = fopen([path name]);
index=0;
while 1
    tline = fgetl(fid);
    if ~ischar(tline), break, end
    if(~strcmp(tline,''))
        index=index+1;
        [longlist(:,index)] = strread(tline,'%s');
    end
end
fclose(fid);

% write file
fid = fopen([path proj_name '.txt'],'w+');
header = {
  'io_path{input =in,output=out,logfile=log.txt}';
  'lattice{'
 };
% write header
for i=1:length(header)
    fprintf(fid,'%s\n', char(header(i)));
end;


%longlist(1,:)=[];
index=0;
s=0;
for i=1:length(longlist)
    class = char(longlist(5,i));
    if(strcmp(class,'SBEN'));
      zpos      = str2num(char(longlist(15,i)));
      if (zpos>zstart & zpos<zstop),
        fprintf(fid,'%s\n', ['        dipole !' char(longlist(2,i))]);
        % get length and strength
        lbend     = str2num(char(longlist(7,i)));
        phi       = str2num(char(longlist(8,i)));
        rho       = lbend/phi;
        dz=rho*sin(phi);ds=rho*sin(phi); s=s+ds;
        if index==0, z0=zpos-dz*0.5; end; 
        z1=zpos-dz*0.5-z0; z2=z1+dz;
        index=index+1;
        fprintf(fid,'          %s\n', ['{position {rho=' num2str(z1) ', psi=0.0, marker=d' num2str(index) 'a}']);
        fprintf(fid,'           %s\n', ['properties {r=' num2str(rho) '}' ]);
        fprintf(fid,'           %s\n', ['position {rho=' num2str(z2) ', psi=0.0, marker=d' num2str(index) 'b}']);
        fprintf(fid,'             }\n');
      end
    end;
    if(strcmp(class,'QUAD'));
      zpos      = str2num(char(longlist(15,i)));
      if (zpos>zstart & zpos<zstop),
        fprintf(fid,'%s\n', ['        dipole !' char(longlist(2,i))]);
        % get length and strength
        lbend     = str2num(char(longlist(7,i)));
        phi       = str2num(char(longlist(8,i)));
        rho       = lbend/phi;
        dz=rho*sin(phi);
        if index==0, z0=zpos-dz*0.5; end; 
        z1=zpos-dz*0.5-z0; z2=z1+dz;
        index=index+1;
        fprintf(fid,'          %s\n', ['{position {rho=' num2str(z1) ', psi=0.0, marker=d' num2str(index) 'a}']);
        fprintf(fid,'           %s\n', ['properties {r=' num2str(rho) '}' ]);
        fprintf(fid,'           %s\n', ['position {rho=' num2str(z2) ', psi=0.0, marker=d' num2str(index) 'b}']);
        fprintf(fid,'             }\n');
      end;
      if(strcmp(class,'SEXT'));
      zpos      = str2num(char(longlist(15,i)));
      if (zpos>zstart & zpos<zstop),
        fprintf(fid,'%s\n', ['        dipole !' char(longlist(2,i))]);
        % get length and strength
        lbend     = str2num(char(longlist(7,i)));
        phi       = str2num(char(longlist(8,i)));
        rho       = lbend/phi;
        dz=rho*sin(phi);
        if index==0, z0=zpos-dz*0.5; end; 
        z1=zpos-dz*0.5-z0; z2=z1+dz;
        index=index+1;
        fprintf(fid,'          %s\n', ['{position {rho=' num2str(z1) ', psi=0.0, marker=d' num2str(index) 'a}']);
        fprintf(fid,'           %s\n', ['properties {r=' num2str(rho) '}' ]);
        fprintf(fid,'           %s\n', ['position {rho=' num2str(z2) ', psi=0.0, marker=d' num2str(index) 'b}']);
        fprintf(fid,'             }\n');
      end
end
fprintf(fid,'   }\n');
fclose(fid);
